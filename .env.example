# Standalone business workbench. DSH is an optional local SDK dependency; Docker is not required.
# Relative paths are relative to the application root. Put large data on your persistent volume.
WORKBENCH_DB=./data/workbench.sqlite3
WORKBENCH_PROCESSOR_TIMEOUT=30
WORKBENCH_SQL_TICKS=10000
MOCK_ERP_DB=./data/mock-erp.sqlite3
MOCK_ERP_PREPARE_TTL_SECONDS=900
