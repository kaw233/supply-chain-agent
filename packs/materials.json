{
  "schema_version": "1.0",
  "id": "materials",
  "version": 1,
  "name": "物料齐套协同",
  "subtitle": "MATERIAL READINESS",
  "description": "保障订单按期开工",
  "template": "operations",
  "goal": {
    "label": "保障订单按期开工",
    "target": 95,
    "unit": "%",
    "metric_label": "检查通过率"
  },
  "fields": [
    {
      "key": "id",
      "label": "对象编号",
      "type": "string",
      "required": true
    },
    {
      "key": "name",
      "label": "业务对象",
      "type": "string",
      "required": true
    },
    {
      "key": "owner",
      "label": "责任人",
      "type": "string",
      "required": true
    },
    {
      "key": "owner_email",
      "label": "责任人邮箱",
      "type": "string"
    },
    {
      "key": "site",
      "label": "工厂",
      "type": "string",
      "required": true
    },
    {
      "key": "supplier",
      "label": "供应商",
      "type": "string"
    },
    {
      "key": "demand",
      "label": "需求数量",
      "type": "number",
      "required": true
    },
    {
      "key": "stock",
      "label": "可用库存",
      "type": "number",
      "required": true
    },
    {
      "key": "inbound",
      "label": "确认在途",
      "type": "number",
      "required": true
    },
    {
      "key": "due_days",
      "label": "距用料天数",
      "type": "number",
      "required": true
    },
    {
      "key": "unit_price",
      "label": "演示单价",
      "type": "number",
      "required": true
    }
  ],
  "mapping": {},
  "parameters": {
    "urgent_days": 3,
    "watch_days": 14
  },
  "derived": [
    {
      "key": "shortage",
      "label": "缺口数量",
      "expr": "max(demand - stock - inbound, 0)"
    },
    {
      "key": "coverage",
      "label": "齐套比例",
      "expr": "round(min((stock + inbound) / max(demand, 1) * 100, 100), 1)"
    },
    {
      "key": "impact",
      "label": "缺口金额（演示估算）",
      "expr": "shortage * unit_price"
    }
  ],
  "rules": [
    {
      "id": "R-M01",
      "name": "紧急欠料",
      "when": "shortage > 0 and due_days <= urgent_days",
      "severity": "high",
      "reason": "缺口 {shortage} 件，距用料 {due_days} 天；进入紧急窗口 {urgent_days} 天。"
    },
    {
      "id": "R-M02",
      "name": "计划欠料",
      "when": "shortage > 0 and due_days <= watch_days",
      "severity": "medium",
      "reason": "缺口 {shortage} 件，需要跟进确认在途与交付承诺。"
    },
    {
      "id": "R-M03",
      "name": "齐套 / 窗口外",
      "when": "True",
      "severity": "normal",
      "reason": "当前检查窗口内未命中欠料风险规则。"
    }
  ],
  "case": {
    "key": "id",
    "title": "{name}",
    "owner_field": "owner",
    "close_policy": "normal_after_rerun"
  },
  "actions": {
    "erp.expedite": {
      "title": "供应商催交",
      "group_by": "id",
      "subject": "[{scene}] 缺料催交确认",
      "body": "请按已确认的缺料数据发起催交：\n{items}\n\n必须先调用 prepare_expedite，再调用 commit_expedite；对象版本变化时停止提交。",
      "executor": "hermes_skill",
      "ui": "notification",
      "name": "供应商催交",
      "operation_type": "expedite",
      "skill_hint": "supply-chain-mock-erp",
      "instruction": "使用已安装的 Mock ERP MCP 工具处理已确认的催交请求。严格使用消息 payload：先调用 prepare_expedite，成功后再使用同一对象版本调用 commit_expedite；最后将外部编号通过 action.receipt 登记。",
      "recipient_field": "supplier",
      "recipient_label": "供应商"
    },
    "email.send": {
      "title": "责任人协同邮件",
      "group_by": "owner_email",
      "subject": "[{scene}] {owner} 的 {count} 项待处理事项",
      "body": "{owner}，你好：\n\n以下事项需要跟进：\n{items}\n\n请补充承诺、处理计划或佐证，并在工作台登记反馈。\n场景：{scene}\n本通知为场景模板生成。",
      "executor": "hermes_skill",
      "ui": "notification",
      "name": "协同邮件",
      "skill_hint": "",
      "instruction": "使用已安装的邮件发送 Skill 发送已确认的通知。",
      "recipient_field": "owner_email",
      "recipient_label": "收件人邮箱"
    },
    "feishu.send": {
      "title": "飞书群协同",
      "group_by": "owner",
      "body": "{scene}：本次有 {count} 项需要协同。\n{items}",
      "executor": "hermes_skill",
      "ui": "notification",
      "name": "飞书通知",
      "skill_hint": "",
      "instruction": "使用已安装的飞书操作 Skill 发送已确认的通知。",
      "recipient_field": "feishu_target",
      "recipient_label": "飞书目标（群或用户标识）"
    },
    "feishu.read": {
      "name": "飞书查证",
      "executor": "hermes_skill",
      "ui": "query",
      "skill_hint": "",
      "instruction": "使用已安装的飞书读取 Skill 查询指定业务对象的相关协同记录。返回原文摘要、来源和时间；缺少 Skill 或访问权限时明确说明。不要使用本地演示消息。"
    }
  },
  "triggers": {
    "data_ready": true,
    "manual": true,
    "agent": true,
    "auto_prepare": false,
    "auto_capability": "erp.expedite"
  },
  "layout": [
    "goals",
    "pipeline",
    "trend",
    "distribution",
    "workload",
    "table",
    "activity"
  ],
  "acceptance": [
    {
      "name": "临近用料且存在缺口 → 高风险",
      "record": {
        "id": "T1",
        "name": "测试件",
        "owner": "测试员",
        "site": "测试工厂",
        "demand": 100,
        "stock": 30,
        "inbound": 20,
        "due_days": 2,
        "unit_price": 100
      },
      "expected": {
        "severity": "high",
        "shortage": 50
      }
    },
    {
      "name": "库存已满足需求 → 正常",
      "record": {
        "id": "T2",
        "name": "测试件",
        "owner": "测试员",
        "site": "测试工厂",
        "demand": 100,
        "stock": 100,
        "inbound": 0,
        "due_days": 2,
        "unit_price": 100
      },
      "expected": {
        "severity": "normal",
        "shortage": 0
      }
    },
    {
      "name": "库存缺失 → 数据待补充",
      "record": {
        "id": "T3",
        "name": "测试件",
        "owner": "测试员",
        "site": "测试工厂",
        "demand": 100,
        "stock": null,
        "inbound": 0,
        "due_days": 2,
        "unit_price": 100
      },
      "expected": {
        "severity": "unknown"
      }
    }
  ],
