{
  "schema_version": "1.0",
  "id": "quality",
  "version": 1,
  "name": "来料质量处置",
  "subtitle": "INCOMING QUALITY",
  "description": "降低异常批次流入风险",
  "template": "quality",
  "goal": {
    "label": "降低异常批次流入风险",
    "target": 95,
    "unit": "%",
    "metric_label": "正常批次占比"
  },
  "fields": [
    {
      "key": "id",
      "label": "对象编号",
      "type": "string",
      "required": true
    },
    {
      "key": "name",
      "label": "业务对象",
      "type": "string",
      "required": true
    },
    {
      "key": "owner",
      "label": "责任人",
      "type": "string",
      "required": true
    },
    {
      "key": "owner_email",
      "label": "责任人邮箱",
      "type": "string"
    },
    {
      "key": "site",
      "label": "工厂",
      "type": "string",
      "required": true
    },
    {
      "key": "supplier",
      "label": "供应商",
      "type": "string"
    },
    {
      "key": "sample_qty",
      "label": "抽检数",
      "type": "number",
      "required": true
    },
    {
      "key": "defective",
      "label": "不良数",
      "type": "number",
      "required": true
    },
    {
      "key": "batch_qty",
      "label": "批次数量",
      "type": "number",
      "required": true
    },
    {
      "key": "unit_price",
      "label": "演示单价",
      "type": "number",
      "required": true
    }
  ],
  "mapping": {},
  "parameters": {
    "critical_pct": 5,
    "warning_pct": 2
  },
  "derived": [
    {
      "key": "reject_pct",
      "label": "不良率",
      "expr": "round(defective / max(sample_qty, 1) * 100, 1)"
    },
    {
      "key": "coverage",
      "label": "抽检合格率",
      "expr": "round(100 - reject_pct, 1)"
    },
    {
      "key": "impact",
      "label": "关联批次金额（非损失）",
      "expr": "batch_qty * unit_price if reject_pct >= warning_pct else 0"
    }
  ],
  "rules": [
    {
      "id": "R-Q00",
      "name": "无有效抽检",
      "when": "sample_qty <= 0",
      "severity": "unknown",
      "reason": "抽检数必须大于 0，当前无法判定质量。"
    },
    {
      "id": "R-Q01",
      "name": "严重质量异常",
      "when": "reject_pct >= critical_pct",
      "severity": "high",
      "reason": "抽检不良率 {reject_pct}%，达到严重阈值 {critical_pct}%。"
    },
    {
      "id": "R-Q02",
      "name": "质量关注",
      "when": "reject_pct >= warning_pct",
      "severity": "medium",
      "reason": "抽检不良率 {reject_pct}%，需要质量复核。"
    },
    {
      "id": "R-Q03",
      "name": "抽检正常",
      "when": "True",
      "severity": "normal",
      "reason": "当前抽检结果未命中异常阈值。"
    }
  ],
  "case": {
    "key": "id",
    "title": "{name}",
    "owner_field": "owner",
    "close_policy": "normal_after_rerun"
  },
  "actions": {
    "email.send": {
      "title": "责任人协同邮件",
      "group_by": "owner_email",
      "subject": "[{scene}] {owner} 的 {count} 项待处理事项",
      "body": "{owner}，你好：\n\n以下事项需要跟进：\n{items}\n\n请补充承诺、处理计划或佐证，并在工作台登记反馈。\n场景：{scene}\n本通知为场景模板生成。",
      "executor": "hermes_skill",
      "ui": "notification",
      "name": "协同邮件",
      "skill_hint": "",
      "instruction": "使用已安装的邮件发送 Skill 发送已确认的通知。",
      "recipient_field": "owner_email",
      "recipient_label": "收件人邮箱"
    },
    "feishu.send": {
      "title": "飞书群协同",
      "group_by": "owner",
      "body": "{scene}：本次有 {count} 项需要协同。\n{items}",
      "executor": "hermes_skill",
      "ui": "notification",
      "name": "飞书通知",
      "skill_hint": "",
      "instruction": "使用已安装的飞书操作 Skill 发送已确认的通知。",
      "recipient_field": "feishu_target",
      "recipient_label": "飞书目标（群或用户标识）"
    },
    "feishu.read": {
      "name": "飞书查证",
      "executor": "hermes_skill",
      "ui": "query",
      "skill_hint": "",
      "instruction": "使用已安装的飞书读取 Skill 查询指定业务对象的相关协同记录。返回原文摘要、来源和时间；缺少 Skill 或访问权限时明确说明。不要使用本地演示消息。"
    }
  },
  "triggers": {
    "data_ready": true,
    "manual": true,
    "agent": true,
    "auto_prepare": false,
    "auto_capability": "email.send"
  },
  "layout": [
    "goals",
    "pipeline",
    "trend",
    "distribution",
    "workload",
    "table",
    "activity"
  ],
  "acceptance": [
    {
      "name": "不良率 8% → 高风险",
      "record": {
        "id": "Q1",
        "name": "抽检测试",
        "owner": "测试员",
        "site": "工厂",
        "sample_qty": 100,
        "defective": 8,
        "batch_qty": 500,
        "unit_price": 20
      },
      "expected": {
        "severity": "high",
        "reject_pct": 8
      }
    },
    {
      "name": "零抽检 → 未知",
      "record": {
        "id": "Q2",
        "name": "抽检测试",
        "owner": "测试员",
        "site": "工厂",
        "sample_qty": 0,
        "defective": 0,
        "batch_qty": 500,
        "unit_price": 20
      },
      "expected": {
        "severity": "unknown"
      }
    }
  ],
